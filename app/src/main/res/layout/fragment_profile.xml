<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi perfil"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/editNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre" />

        <EditText
            android:id="@+id/editEmailPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/editTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:inputType="phone" />

        <EditText
            android:id="@+id/editZona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Zona" />

        <Button
            android:id="@+id/buttonGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar cambios"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reputación"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/textReputacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.7 estrellas"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textOperaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 operaciones concretadas"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textCompradorVendedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7 como comprador · 5 como vendedor"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/textAntiguedad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Antigüedad: 2 años"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/textPublicacionesActivas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Publicaciones activas: 3"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</ScrollView>