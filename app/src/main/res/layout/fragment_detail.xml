<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.Ronda.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- Banner de modo sin conexión -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bannerDetailOffline"
            style="@style/Widget.Ronda.Card.Banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="Sin conexión"
                    android:src="@android:drawable/stat_notify_error"
                    app:tint="?attr/colorOnErrorContainer" />

                <TextView
                    android:id="@+id/textBannerDetailOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="Modo sin conexión: las acciones sobre la publicación están deshabilitadas."
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnErrorContainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Galería de fotos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageFotoViewer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gallery_height"
                    android:background="?attr/colorSurfaceVariant"
                    android:contentDescription="Foto del artículo"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFotoAnterior"
                        style="@style/Widget.Ronda.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Foto anterior"
                        app:icon="@drawable/ic_chevron_left" />

                    <TextView
                        android:id="@+id/textFotoIndicador"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Foto 1 de 3"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFotoSiguiente"
                        style="@style/Widget.Ronda.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Foto siguiente"
                        app:icon="@drawable/ic_chevron_right" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Información principal del artículo -->
        <TextView
            android:id="@+id/textDetailTitulo"
            style="@style/Widget.Ronda.Text.ScreenTitle"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Título del Artículo" />

        <TextView
            android:id="@+id/textDetailPrecio"
            style="@style/Widget.Ronda.Text.Price.Large"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Precio: $0" />

        <!-- Ficha técnica rápida -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textDetailEstado"
                    style="@style/Widget.Ronda.Text.Meta"
                    android:text="Estado: -" />

                <TextView
                    android:id="@+id/textDetailCategoria"
                    style="@style/Widget.Ronda.Text.Meta"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Categoría: -" />

                <TextView
                    android:id="@+id/textDetailZona"
                    style="@style/Widget.Ronda.Text.Meta"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Zona de entrega: -" />

                <TextView
                    android:id="@+id/textDetailDireccion"
                    style="@style/Widget.Ronda.Text.Meta"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Dirección: -"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textDetailFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Fecha de publicación: -"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Descripción Completa -->
        <TextView
            style="@style/Widget.Ronda.Text.SectionTitle"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Descripción" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs">

            <TextView
                android:id="@+id/textDetailDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción completa del artículo..."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Datos del Vendedor -->
        <TextView
            style="@style/Widget.Ronda.Text.SectionTitle"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Información del vendedor" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textVendedorNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vendedor: Nombre Apellido"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/textVendedorReputacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Reputación: ★ 4.9 (42 ventas)"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonVerPerfilVendedor"
                    style="@style/Widget.Ronda.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/action_public_profile" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN: Acciones para Interesado / Comprador -->
        <LinearLayout
            android:id="@+id/containerAccionesComprador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Ronda.Text.SectionTitle"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="Preguntas y respuestas" />

            <LinearLayout
                android:id="@+id/containerPreguntasComprador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.Ronda.Text.SectionTitle"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="Acciones disponibles" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPreguntar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preguntar al vendedor"
                app:icon="@drawable/ic_chat" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOfertar"
                style="@style/Widget.Ronda.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Hacer una oferta de precio"
                app:icon="@drawable/ic_local_offer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGuardar"
                style="@style/Widget.Ronda.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Guardar en favoritos"
                app:icon="@drawable/ic_favorite_border" />

        </LinearLayout>

        <!-- SECCIÓN: Acciones para el propio Vendedor -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerAccionesVendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Ronda.Text.SectionTitle"
                    android:text="Gestión de tu publicación" />

                <TextView
                    style="@style/Widget.Ronda.Text.Meta"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Como sos el autor de esta publicación, podés administrarla." />

                <TextView
                    style="@style/Widget.Ronda.Text.SectionTitle"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Preguntas recibidas" />

                <LinearLayout
                    android:id="@+id/containerPreguntasRecibidas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonModificar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="Modificar publicación"
                    app:icon="@drawable/ic_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPausar"
                    style="@style/Widget.Ronda.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Pausar publicación"
                    app:icon="@drawable/ic_pause" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
