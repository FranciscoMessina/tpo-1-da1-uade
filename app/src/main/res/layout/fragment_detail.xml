<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Botón Volver -->
        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="← Volver a publicaciones" />

        <!-- Galería de fotos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0E0E0"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textFotoViewer"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#CCCCCC"
                android:gravity="center"
                android:padding="12dp"
                android:text="📱 Foto 1"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonFotoAnterior"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀ Anterior" />

                <TextView
                    android:id="@+id/textFotoIndicador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="Foto 1 de 3"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/buttonFotoSiguiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siguiente ▶" />

            </LinearLayout>

        </LinearLayout>

        <!-- Información principal del artículo -->
        <TextView
            android:id="@+id/textDetailTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Título del Artículo"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetailPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Precio: $0"
            android:textColor="#2E7D32"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Ficha técnica rápida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/textDetailEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: -"
                android:textColor="#424242"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textDetailCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Categoría: -"
                android:textColor="#424242"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textDetailZona"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Zona de entrega: -"
                android:textColor="#424242"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textDetailFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fecha de publicación: -"
                android:textColor="#757575"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Descripción Completa -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Descripción"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetailDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="Descripción completa del artículo..."
            android:textColor="#333333"
            android:textSize="15sp" />

        <!-- Datos del Vendedor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Información del Vendedor"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/textVendedorNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vendedor: Nombre Apellido"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textVendedorReputacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Reputación: ★ 4.9 (42 ventas)"
                android:textColor="#E65100"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonVerPerfilVendedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ver perfil público" />

        </LinearLayout>

        <!-- SECCIÓN: Acciones para Interesado / Comprador -->
        <LinearLayout
            android:id="@+id/containerAccionesComprador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Acciones disponibles"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonPreguntar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 Preguntar al vendedor" />

            <Button
                android:id="@+id/buttonOfertar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="💰 Hacer una oferta de precio" />

            <Button
                android:id="@+id/buttonGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⭐ Guardar en favoritos" />

        </LinearLayout>

        <!-- SECCIÓN: Acciones para el propio Vendedor -->
        <LinearLayout
            android:id="@+id/containerAccionesVendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="#FFF9C4"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📌 Gestión de tu publicación"
                android:textColor="#5D4037"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Como sos el autor de esta publicación, podés administrarla:"
                android:textColor="#5D4037"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonModificar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="✏️ Modificar publicación" />

            <Button
                android:id="@+id/buttonPausar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⏸️ Pausar publicación" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
