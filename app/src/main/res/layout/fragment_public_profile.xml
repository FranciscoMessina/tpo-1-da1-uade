<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVolverPerfilPublico"
            style="@style/Widget.Ronda.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/imagePerfilPublicoAvatar"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_avatar"
            android:clipToOutline="true"
            android:contentDescription="Foto de perfil del vendedor"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_photo_camera" />

        <TextView
            android:id="@+id/textPerfilPublicoNombre"
            style="@style/Widget.Ronda.Text.ScreenTitle"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="Perfil del vendedor" />

        <TextView
            android:id="@+id/textPerfilPublicoEmail"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="Zona" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textPerfilPublicoReputacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reputación"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/textPerfilPublicoAntiguedad"
                    style="@style/Widget.Ronda.Text.Meta"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Antigüedad" />

                <TextView
                    android:id="@+id/textPerfilPublicoOperaciones"
                    style="@style/Widget.Ronda.Text.Meta"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Operaciones" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Ronda.Text.SectionTitle"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Publicaciones activas" />

        <LinearLayout
            android:id="@+id/containerPublicacionesVendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical" />

        <TextView
            style="@style/Widget.Ronda.Text.SectionTitle"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Calificaciones recibidas" />

        <LinearLayout
            android:id="@+id/containerCalificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMasCalificaciones"
            style="@style/Widget.Ronda.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Ver más calificaciones"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
