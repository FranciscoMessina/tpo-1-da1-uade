<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de operación. Sigue el mismo patrón que item_publication:
    la tarjeta entera es pulsable, "Ver detalle" es una afordancia (no un botón)
    y debajo van solo las acciones que no son "abrir el detalle".
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardOperation"
    style="@style/Widget.Ronda.Card.List"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textOperationMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/textOperationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/textOperationAmount"
            style="@style/Widget.Ronda.Text.Price"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/textOperationCounterparty"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/textOperationRating"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/textOperationDetailHint"
            style="@style/Widget.Ronda.Text.Link"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/action_detail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOperationRate"
            style="@style/Widget.Ronda.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Calificar" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
