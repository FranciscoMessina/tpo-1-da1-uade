<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de búsqueda guardada. Mismo formato que el resto de las listas. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardSavedSearch"
    style="@style/Widget.Ronda.Card.List"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textSavedSearchName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/textSavedSearchNews"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonUseSavedSearch"
                style="@style/Widget.Ronda.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usar búsqueda" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeleteSavedSearch"
                style="@style/Widget.Ronda.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="Eliminar" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
