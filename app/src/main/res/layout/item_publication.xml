<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de publicación. Es la única representación de una publicación en una
    lista: la usan Inicio, Favoritos, Mis publicaciones y el perfil público.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPublication"
    style="@style/Widget.Ronda.Card.List"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPublicationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/buttonPublicationFavorite"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Guardar en favoritos"
                android:scaleType="center"
                android:src="@drawable/ic_favorite_border" />
        </LinearLayout>

        <TextView
            android:id="@+id/textPublicationDescription"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/textPublicationPrice"
            style="@style/Widget.Ronda.Text.Price"
            android:layout_marginTop="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/textPublicationCondition"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/textPublicationCategory"
            style="@style/Widget.Ronda.Text.Meta" />

        <TextView
            android:id="@+id/textPublicationZone"
            style="@style/Widget.Ronda.Text.Meta" />

        <TextView
            android:id="@+id/textPublicationStatus"
            style="@style/Widget.Ronda.Text.Meta"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textPublicationUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textPublicationDetailHint"
            style="@style/Widget.Ronda.Text.Link"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/action_detail" />

        <!-- Acciones propias del dueño de la publicación (editar, pausar…). -->
        <LinearLayout
            android:id="@+id/containerPublicationActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
