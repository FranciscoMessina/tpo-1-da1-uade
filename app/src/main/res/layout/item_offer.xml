<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de oferta enviada/recibida. Mismo formato que el resto de las listas. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardOffer"
    style="@style/Widget.Ronda.Card.List"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textOfferTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/textOfferAmount"
            style="@style/Widget.Ronda.Text.Price"
            android:layout_marginTop="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/textOfferCounterAmount"
            style="@style/Widget.Ronda.Text.Price"
            android:layout_marginTop="@dimen/spacing_xs"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textOfferStatus"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/textOfferCreatedAt"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/textOfferExpiresAt"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/textOfferMessage"
            style="@style/Widget.Ronda.Text.Meta"
            android:layout_marginTop="@dimen/spacing_xs"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/containerOfferActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
